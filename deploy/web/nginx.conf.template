server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Types MIME standard (html, js, css, images, wasm...).
    # Ne pas ajouter de bloc "types { }" ici : il remplacerait toute la liste
    # et le navigateur téléchargerait les pages au lieu de les afficher.
    include /etc/nginx/mime.types;

    gzip on;
    gzip_types application/javascript application/wasm text/css application/json;
    gzip_min_length 1024;

    # La page d'entrée ne doit pas rester en cache (sinon les mises à jour n'apparaissent pas)
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
